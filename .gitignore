__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
.venv/
venv/
env/

# Jupyter's autosave copies. Six of these were sitting untracked in the tree,
# one of them a stale copy of a test file -- close enough to the real thing to
# be opened by mistake.
.ipynb_checkpoints/

# Run artifacts (regeneratable) -- except the ledgers that every number in the
# paper is computed from, and each run's resolved configuration. Samples,
# checkpoints and caches stay out (git's rule: a file can only be re-included
# if its parent directory is, hence runs/** rather than runs/).
output/
runs/**
!runs/*/
!runs/*/results.jsonl
!runs/*/pricing.jsonl
!runs/*/*/
!runs/*/*/config.json
runs/smoke/**
# The radial spectral profiles the band tables and spectral macros are computed
# from (a few hundred kB), so the paper can be rebuilt without the samples. The
# reference feature caches (several GB) stay out.
!runs/pricing/cache/*.json
!runs/pricing/cache/*/
!runs/pricing/cache/*/ref_profile.npy
!runs/pricing/cache/*/profiles/
!runs/pricing/cache/*/profiles/*.npy
# 2 GB of downloaded and re-encoded datasets. Every one is rebuilt by
# `awwl prepare-data`, and the 163 MB CIFAR tarball is not covered by the
# *.png rule below, so it was one `git add -A` away from the history.
/data/
generated_images/
results/
*.png
*.jpg
*.jpeg
*.csv

# Allow figures intentionally checked in
!assets/**/*.png

# The manuscript's figures are generated on the box with the data and typeset
# on the box with TeX, which are not the same machine -- so they have to travel
# through the repo. `paper/build.sh` tells the reader to commit them; the
# blanket *.png above meant `git add paper/figures` silently added nothing.
!paper/figures/
!paper/figures/*.png

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Paper PDF — kept locally, distributed elsewhere
Cita_2025_Hanu.pdf
*.pdf

# Local-only scripts (history bootstrapper)
.history.py

# clean-fid caches its InceptionV3 weights into the CWD on first use
inception-2015-12-05.pt

# Paper drafts and analysis notes. Tracked now that the repository is
# private; make it public again only after submission, and check what is
# in here before you do.
AWWL_*.md

# LaTeX build products. tables/ and figures/ are tracked despite being
# generated: they are produced on the machine with the data and consumed on
# the machine with TeX, and those are not the same machine here. Regenerate
# rather than edit -- scripts/make_tables.py and `awwl spectrum`.
paper/main.pdf
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Submission material (cover letter with suggested reviewers, packaged
# source, forms) stays private; scripts/make_submission.py regenerates it.
paper/submission/
